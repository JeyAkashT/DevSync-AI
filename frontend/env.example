# Copy to .env for Vite. Only keys prefixed with VITE_ are exposed to the browser.

# Public API base used by Axios when not using the dev proxy (optional)
# VITE_API_BASE_URL=http://localhost:8080

# Dev server proxy target (used by vite.config.ts — set in shell, not Vite env)
# VITE_PROXY_TARGET=http://localhost:8080

# JWTs are stored in localStorage (devsync.ai.accessToken). Prefer httpOnly cookies for production hardening.
