# Copy to .env in this directory and load into your shell, or export manually.
# Spring Boot reads SPRING_* and other vars from the environment.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/devsync_ai
SPRING_DATASOURCE_USERNAME=devsync
SPRING_DATASOURCE_PASSWORD=devsync123
SPRING_DATASOURCE_POOL_MAX=10

# HS256 signing secret — MUST be at least 32 UTF-8 bytes in production (use a strong random value)
DEVSYNC_JWT_SECRET=replace-with-a-long-random-secret-key-32b-min
DEVSYNC_JWT_EXPIRATION_SECONDS=86400
DEVSYNC_JWT_ISSUER=devsync-ai

# CORS: comma-separated origins for browser clients
DEVSYNC_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo seed (Flyway + startup). Creates org, project, tasks, bugs, comments, activity samples.
# Requires `devsync.seed.enabled` (Spring: DEVSYNC_SEED_ENABLED=true).
DEVSYNC_SEED_ENABLED=false
DEVSYNC_SEED_DEMO_EMAIL=pm-demo@devsync.ai
DEVSYNC_SEED_DEMO_PASSWORD=DemoPass123!
DEVSYNC_SEED_ORG_SLUG=devsync-demo

# Server port (optional)
# SERVER_PORT=8080
